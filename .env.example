# Random secret — currently unused by auth (Supabase Auth owns sessions now)
# but kept around for anything else that wants a signing key. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Supabase project — Settings > API (Project URL, and either the new
# "Publishable key"/"Secret key" pair or the legacy anon/service_role pair;
# either naming works) and Settings > Database > Connect > Session pooler
# for the connection string (fill in the real password in place of the
# placeholder in the copied string).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Public Storage bucket serving design/order-reference photos. Must exist
# before the app can upload — create it once per Supabase project (Storage >
# New bucket, Public), matching this name.
SUPABASE_STORAGE_BUCKET=photos

# There's no admin signup form — bootstrap (or reset) the first admin with:
# npm run admin:create -- "owner@example.com" "a-strong-password" "Display Name"
# Re-running it for an existing email resets that account's password and
# (re)grants admin access. After that, admins can promote/demote other
# registered accounts from /admin/admins.

# Public base URL used to build Stripe Checkout's redirect URLs and to
# register its webhook endpoint. Must be publicly reachable (Stripe redirects
# the customer's browser here) — localhost is fine for local-only testing.
SITE_URL=http://localhost:3000

# Stripe API keys — Dashboard > Developers > API keys. Use the *test mode*
# keys while sandboxing (sk_test_ / pk_test_).
STRIPE_SECRET_KEY=
# Not currently read server-side (checkout is Stripe's hosted page, no
# client-side Stripe.js involved) — kept for any future client-side use.
STRIPE_PUBLISHABLE_KEY=

# From Dashboard > Developers > Webhooks (or `stripe listen`) once an
# endpoint is registered at <SITE_URL>/api/stripe/webhook, listening for
# checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, and checkout.session.expired.
STRIPE_WEBHOOK_SECRET=
