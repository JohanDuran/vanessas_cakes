# Where the SQLite file and uploaded photos are stored.
DATA_DIR=./data

# Random secret used to sign the login session cookie (shared by customer
# and admin accounts — admin access is just a per-user flag, not a separate
# login). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# There's no admin signup form — bootstrap (or reset) the first admin with:
# npm run admin:create -- "owner@example.com" "a-strong-password" "Display Name"
# Re-running it for an existing email resets that account's password and
# (re)grants admin access. After that, admins can promote/demote other
# registered accounts from /admin/admins.
