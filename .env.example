# Where the SQLite file and uploaded photos are stored.
DATA_DIR=./data

# bcrypt hash of the shared admin password.
# Generate with: npm run admin:hash-password -- "your-password"
# IMPORTANT: this differs by where the value is read from.
#   - .env.local (read by `next dev`/`next build` via @next/env, which expands
#     "$VAR"): escape every "$" as "\$", e.g. \$2b\$12\$...
#   - .env used as docker-compose's env_file (passed straight through, no
#     expansion): paste the hash unescaped, e.g. $2b$12$...
ADMIN_PASSWORD_HASH=

# Random secret used to sign the admin session cookie. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
